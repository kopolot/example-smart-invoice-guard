# Big SaaS — zmienne środowiskowe (skopiuj do .env lub merge z .env.example)
#
# Włącza multi-tenant routing i dodatkowe połączenia DB z config/database.big-saas.php

BIG_SAAS_ENABLED=true

# Dev override — symulacja tenant context bez control plane
BIG_SAAS_TENANT_ID=1
BIG_SAAS_TIER=normal
# BIG_SAAS_PREMIUM_CLUSTER=1
# BIG_SAAS_ENTERPRISE_CLUSTER=1

# Control plane (tenant_registry)
BIG_SAAS_CONTROL_DB_HOST=control-db
BIG_SAAS_CONTROL_DB_DATABASE=tenant_registry

# Shared tier — alias istniejącego ProxySQL (normal users, DB per tenant)
BIG_SAAS_SHARED_DB_HOST=shared-db
BIG_SAAS_SHARED_DB_DATABASE=laravel
BIG_SAAS_SHARED_DB_PREFIX=sig_shared_tenant_

# Premium clusters 1..3
BIG_SAAS_PREMIUM_CLUSTER_COUNT=3
BIG_SAAS_PREMIUM_1_DB_HOST=premium-db-1
BIG_SAAS_PREMIUM_2_DB_HOST=premium-db-2
BIG_SAAS_PREMIUM_3_DB_HOST=premium-db-3
BIG_SAAS_PREMIUM_DB_PREFIX=sig_premium_tenant_

# Enterprise cluster 1 (dedykowany tenant)
BIG_SAAS_ENTERPRISE_1_DB_HOST=enterprise-db-1
BIG_SAAS_ENTERPRISE_DB_PREFIX=sig_enterprise_
