datadir="/var/lib/proxysql"

admin_variables=
{
    admin_credentials="admin:admin"
    mysql_ifaces="0.0.0.0:6032"
}

mysql_variables=
{
    threads=4
    max_connections=2048
    default_query_delay=0
    default_query_timeout=36000000
    have_compress=true
    poll_timeout=2000
    interfaces="0.0.0.0:3306"
    default_schema="laravel"
    server_version="8.0.36"
    connect_timeout_server=10000
    monitor_username="root"
    monitor_password="root"
    monitor_history=600000
    monitor_connect_interval=20000
    monitor_ping_interval=10000
    monitor_read_only_interval=1500
    monitor_read_only_timeout=500
    ping_interval_server_msec=10000
    ping_timeout_server=500
    commands_stats=true
    sessions_sort=true
}

mysql_servers =
(
    { address="pxc-node1", port=3306, hostgroup=10, max_connections=200, weight=1000 },
    { address="pxc-node2", port=3306, hostgroup=10, max_connections=200, weight=1000 },
    { address="pxc-node3", port=3306, hostgroup=10, max_connections=200, weight=1000 }
)

mysql_users =
(
    { username="laravel", password="laravel", default_hostgroup=10, transaction_persistent=1, active=1 },
    { username="root", password="root", default_hostgroup=10, transaction_persistent=1, active=1 }
)

mysql_galera_hostgroups =
(
    {
        writer_hostgroup=10
        backup_writer_hostgroup=20
        reader_hostgroup=30
        offline_hostgroup=40
        max_writers=1
        writer_is_also_reader=1
        max_transactions_behind=100
        active=1
    }
)
